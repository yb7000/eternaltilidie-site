# Portal (/portal): The Reflection Wizard.
# Submissions are not stored. Each one is turned into a Reflection with Claude and
# emailed to the artist, and a copy with every answer attached goes to the team.

# Writes the Reflection. Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-5).
PORTAL_MODEL=

# Sends the emails. Create a key at https://resend.com/ and verify the sending domain.
RESEND_API_KEY=
# Verified sender, e.g. "Eternal <reflections@eternaltilidie.com>"
PORTAL_FROM_EMAIL=
# Team inbox that receives a copy of every Reflection with the answers attached.
PORTAL_NOTIFY_EMAIL=
# Optional: reply-to on the artist's email (defaults to PORTAL_NOTIFY_EMAIL).
PORTAL_REPLY_TO=
